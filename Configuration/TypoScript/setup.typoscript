cartQuickpay = PAGE
cartQuickpay {
    typeNum = {$plugin.tx_cartquickpay.redirectTypeNum}

    config {
        disableAllHeaderCode = 1
        xhtml_cleaning = 0
        admPanel = 0
        debug = 0
        no_cache = 1
    }

    10 = EXTBASEPLUGIN
    10 {
        extensionName = CartQuickpay
        pluginName = Cart
    }
}

plugin.tx_cartquickpay {

    redirectTypeNum = {$plugin.tx_cartquickpay.redirectTypeNum}

    # The former "finishers.order.success" configuration is gone in EXT:cart 11.
    # After a successful payment the PaymentController dispatches
    # \Extcode\Cart\Event\Order\FinishEvent - all listeners of this event
    # (mails and clear cart from EXT:cart, usergroup assignment from
    # EXT:cart_products_usergroup, ...) are executed.

    settings {
        api_user = {$plugin.tx_cartquickpay.settings.api_user}
    }
}
